# 运行模式：production 为生产环境，debug 为调试环境。修改后重启后端。
# production：默认 info 日志，不记录堆栈、不显示追踪 ID。
# debug：默认 debug 日志，包含错误堆栈、处理耗时和追踪 ID。
APP_MODE=production
# 留空使用当前模式的默认值；可填写 debug / info / warn / error。
# 日志同时输出到终端和 DATA_DIR/logs/backend.jsonl。
LOG_LEVEL=
# 留空随 APP_MODE；true 开启链路追踪，false 关闭。
# 追踪开启后，可关联同次操作的日志、网页错误和群内失败回复。
LOG_TRACE_ENABLED=

# 监听地址：前后端同机时由 Nginx 转发，保持 127.0.0.1。
HOST=127.0.0.1
# 与 Nginx / 宝塔 Node 项目的代理端口保持一致。
PORT=19988
# 后台登录账号；生产环境必须更换默认密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=dev-password-change-me
# 至少 32 个随机字符，用于登录会话和音频下载票据签名。
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# NapCat 反向 WebSocket 的独立 Token；与设备凭证、会话密钥分开设置。
ONEBOT_TOKEN=replace-with-a-separate-random-onebot-token
# mysql 为生产存储；file 可用于不连接数据库的本地开发。
STORAGE_DRIVER=mysql
# MySQL 连接串；密码中的 @、#、% 等字符需要 URL 编码。
DATABASE_URL=mysql://qqmusic:change-me@127.0.0.1:3306/qqmusic
# 相对于 backend 目录；存放缓存、日志、工具和文件存储数据。
DATA_DIR=./data
# 浏览器使用 HTTP 时 false，HTTPS 时 true。
COOKIE_SECURE=false
# 浏览器访问的源地址，包含协议和非默认端口，不含路径和末尾斜杠。
PUBLIC_URL=http://music.example.com
# 可选：后台启用 AI 审核时使用的服务密钥，接口地址和模型在后台设置。
# AI_API_KEY=
# 可选音乐平台登录态，仅后端读取，不发送到管理网页。
# 使用对应音乐平台的账号登录态；NapCat 登录不会自动提供。修改后重启后端。
# NETEASE_COOKIE=
# QQ_MUSIC_COOKIE=
